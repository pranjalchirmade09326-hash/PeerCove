# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# The core app (Postgres + this Next.js server) will run with just the
# DATABASE_URL / NEXT_PUBLIC_APP_URL section below filled in. Everything
# past that points at external services (IAM/auth server, FHIR server,
# AI agents, LiveKit, Vapi, FileNest, ...) that live in separate repos â€”
# features depending on them will error or no-op until those services are
# reachable at the configured URLs.

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Matches the postgres service in docker-compose.yml / docker-compose.dev.yml
DATABASE_URL="postgresql://peercove:peercove@localhost:5435/peercove?schema=public"

# â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_APP_URL=http://localhost:4000

# â”€â”€ Server Actions (production Docker builds only â€” see docker-build.sh) â”€â”€â”€â”€
# Must stay identical across every build/redeploy, or already-open browser
# tabs get "Failed to find Server Action" after you redeploy. Generate once
# with `openssl rand -base64 32` and never regenerate it.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# â”€â”€ BetterAuth (in-repo PeerCove IAM â€” backend/peercove-iam-py) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Start it with `uv run uvicorn app.main:app --port 5001` in backend/peercove-iam-py. Accounts, sessions, and
# signing keys persist in PostgreSQL schema `iam`. JWT issuer and audience are
# consumed by backend/peercove-api.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_URL=http://localhost:5001
# Required only by the mobile OAuth token route; the in-repo IAM uses sessions.
NEXT_PUBLIC_BETTER_AUTH_CLIENT_ID=your_better_auth_client_id
BETTER_AUTH_CLIENT_SECRET=your_better_auth_client_secret
BETTER_AUTH_JWKS_URL=http://localhost:5001/api/auth/jwks
# After `uv run python -m app.seed` in backend/peercove-iam-py, sign in with any demo account,
# e.g. member@peercove.test / PeerCoveDemo123!

# â”€â”€ PeerCove API (private server-side endpoint) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PEERCOVE_API_URL=http://localhost:8080

# â”€â”€ FHIR server (external â€” separate repo) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FHIR_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_FHIR_SERVER_URL=http://localhost:8000
FHIR_GQL_URL=http://localhost:8005/api/v1
FHIR_STAGING_SERVER_URL=http://localhost:8002/api/v1/staging-records

# GraphQL endpoint (mounted at server root, not under /api/v1). Used only by
# the ai-hub create_patient workflow pilot â€” see src/app/api/workflow/_lib.ts.
FHIR_GRAPHQL_URL=http://localhost:8005/graphql

# restapi or graphql transport for the FHIR client (default restapi)
FHIR_TRANSPORT=rest

# â”€â”€ ABDM (Ayushman Bharat Digital Mission) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret

# â”€â”€ Vapi (voice AI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key
NEXT_PUBLIC_VAPI_AGENT_ID=your_vapi_agent_id

# â”€â”€ LiveKit (video/voice consultations) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_AGENT_URL=http://localhost:8000

# â”€â”€ LLM providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
THESYS_API_KEY=your_thesys_api_key
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=your_copilot_cloud_public_api_key

# â”€â”€ AI agents (external Python microservices â€” see agents/ for local dev) â”€â”€
INTAKE_AGENT_URL=http://localhost:8018/api/agent/intake
CONSULTATION_AGENT_URL=http://localhost:8018/api/agent/consult
ASSESSMENT_PLAN_AGENT_URL=http://localhost:8018/api/agent/assessment
DOCTOR_REPORT_AGENT_URL=http://localhost:8018/api/agent/consultation-workflow
MCP_AGENT_URL=http://localhost:8018/api/agent/mcpagent
DOCTOR_ASSISTANT_AGENT_URL=http://localhost:8018/api/agent/doctoragent
AGENT_CLINICAL_API_URL=http://localhost:8018/api/agent/clinical-extraction
DOCUMENT_AGENT_API_URL=http://localhost:8018/api/agent/document
PDF_CHAT_AGENT_API_URL=http://localhost:8018/api/agent/pdf-chat

INTAKE_VOICE_AGENT_URL=http://localhost:8018
CONSULTATION_VOICE_AGENT_URL=http://localhost:8018
INPERSON_CONSULTATION_AGENT_URL=http://localhost:8018

# A2UI workflow agent
AGENT_API_URL=http://localhost:8015/api/agent/workflow

# â”€â”€ FileNest (document/report storage) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FILENEST_API_KEY=your_filenest_api_key
FILENEST_PROJECT_ID=your_filenest_project_id
FILENEST_API_URL=http://localhost:8000
FILENEST_WEBHOOK_SECRET=your_filenest_webhook_secret

NEXT_PUBLIC_FILENEST_PROJECT_ID=your_filenest_project_id
NEXT_PUBLIC_FILENEST_API_URL=http://localhost:8000

# â”€â”€ Redis (provisioned via docker-compose.yml, not yet consumed by the app) â”€
